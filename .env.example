
# Local development outside Docker
DATABASE_URL=postgresql://mwitu:change-me@127.0.0.1:5432/mwitu
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=
# Comma-separated user IDs obtained from the application's PostgreSQL database.
ADMIN_USER_IDS=
API_HOST=127.0.0.1
API_PORT=4000
# INTERNAL_API_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Docker Compose uses these instead of DATABASE_URL
POSTGRES_PASSWORD=
EDGE_PORT=8092

# Production only. Set APP_ORIGIN to https:// followed by the public domain.
MWITU_DOMAIN=

# Optional LiveKit server or cloud project
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

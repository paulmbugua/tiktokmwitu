
# Local development outside Docker
DATABASE_URL=postgresql://mwitu:change-me@127.0.0.1:5432/mwitu
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=
# Comma-separated user IDs obtained from the application's PostgreSQL database.
ADMIN_USER_IDS=
API_HOST=127.0.0.1
API_PORT=4000
# INTERNAL_API_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Docker Compose uses these instead of DATABASE_URL
POSTGRES_PASSWORD=
EDGE_PORT=8092

# Production only. Set APP_ORIGIN to https:// followed by the public domain.
MWITU_DOMAIN=

# Optional LiveKit server or cloud project
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_PLAYBACK_HOST=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_JWK=

# Production media storage, matching the Cloudflare Worker's secret.
R2_MEDIA_ORIGIN=
MEDIA_STORAGE_SECRET=

# LIVE coins. Use credentials provisioned for Tiktok mwitu.
PAYMENT_API_ORIGIN=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
GIFTS_ALLOW_TEST_PAYMENTS=false
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_WEB_REDIRECT_URI=
GOOGLE_ANDROID_CLIENT_ID=

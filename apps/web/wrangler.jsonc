{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tiktokmwitu-web",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tiktokmwitu.co.ke", "custom_domain": true },
    { "pattern": "admin.tiktokmwitu.co.ke", "custom_domain": true }
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/admin*", "/index.html"]
  }
}
